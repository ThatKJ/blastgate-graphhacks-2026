# Copy to .env (git-ignored) and load with:  set -a; source .env; set +a
# Never commit .env or put a real key in any tracked file.

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
BLASTGATE_GRAPH=blastgate_m1

# --- Agent provider ---
# groq          = live LLM on GroqCloud (needs GROQ_API_KEY)
# deterministic = labelled rule-based demo planner (no LLM, no key)
# unset         = /api/agent/investigate returns 503 agent_provider_not_configured
AGENT_PROVIDER=groq
AGENT_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your-groq-api-key-here
AGENT_TIMEOUT_S=30
AGENT_MAX_TOOL_CALLS=6
MCP_TIMEOUT_S=30

# --- Live (paid / quota-limited) investigation protection ---
# Unset: live investigations are accepted only from this machine (loopback, no proxy headers).
# Set:   every live investigation must send  Authorization: Bearer <token>  (the console asks for it).
# Use a long random value, e.g.  python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_LIVE_TOKEN=
AGENT_LIVE_MAX_PER_CLIENT_MINUTE=2
AGENT_LIVE_MAX_PER_MINUTE=3
AGENT_LIVE_MAX_PER_DAY=60
